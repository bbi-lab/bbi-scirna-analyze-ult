      }

      withName: merge_starsolo_reports {
        cpus = 1
        memory = '8 G'
        queue = queue_short
        time = 4.h
      }

      withName: split_starsolo_stats {
        cpus = 1 
        memory = '8 G'
        queue = queue_short
        time = 4.h
      }

      withName: cat_matrices_raw {
        cpus = 1
        memory = '24 G'
        queue = queue_short
        time = 4.h
      }

      withName: cat_matrices_filtered {
        cpus = 1
        memory = '24 G'
